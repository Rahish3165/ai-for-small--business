# BoothIQ Environment Variables
# Copy this file to .env and fill in your credentials

# Supabase Configuration (Optional - demo data used if empty)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Key (Optional - smart offline advisor used if empty)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash
